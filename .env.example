NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=file:./data/dev.db
# Generate locally: openssl rand -base64 48
SESSION_SECRET=
LOG_LEVEL=info
QUEUE_CAPACITY=1000
DEFAULT_ALGORITHM=FCFS
AGING_INTERVAL_MS=5000
AGING_FACTOR=2
PRIORITY_CAP=100
STARVATION_WARNING_MS=30000
SIMULATION_TICK_MS=250
WATCHDOG_STUCK_MS=15000
WORKER_LEASE_MS=5000
ENABLE_FAULT_INJECTION=false
AUTH_MODE=local
TRUST_PROXY=false
