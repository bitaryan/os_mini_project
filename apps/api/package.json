{
  "name": "@printer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "demo": "node --import tsx src/demo.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:backup": "node --import tsx src/database-maintenance.ts backup",
    "db:restore": "node --import tsx src/database-maintenance.ts restore",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@printer/contracts": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "socket.io": "4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@printer/test-fixtures": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13"
  }
}
